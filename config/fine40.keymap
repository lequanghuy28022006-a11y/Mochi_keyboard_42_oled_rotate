#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";
            bindings = <
&kp ESC      &kp Q     &kp W     &kp E      &kp R    &kp T      &kp Y      &kp U     &kp I      &kp O     &kp P     &kp BSPC
&kp TAB      &kp A     &kp S     &kp D      &kp F    &kp G      &kp H      &kp J     &kp K      &kp L     &kp SEMI  &kp RET
&kp LSHFT    &kp Z     &kp X     &kp C      &kp V    &kp B      &kp N      &kp M     &kp COMMA  &kp DOT   &kp FSLH  &lt 3 SQT
&lt 4 LCTRL  &kp LGUI  &kp LALT  &kp BSLH   &mo 1    &kp SPACE  &kp LEFT   &kp DOWN  &kp RIGHT  &mo 2     &kp UP    &to 1
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            display-name = "NUM";
            bindings = <
&kp GRAVE  &kp N1    &kp N2    &kp N3     &kp N4   &kp N5     &kp N6       &kp N7       &kp N8       &kp N9    &kp N0    &kp DEL
&kp TAB    &kp EXCL  &kp AT    &kp HASH   &kp DLLR &kp PRCNT  &kp CARET    &kp MINUS    &kp EQUAL    &kp LBKT  &kp RBKT  &kp BSLH
&kp LSHFT  &kp LPAR  &kp RPAR  &kp LBRC   &kp RBRC &kp PLUS   &kp STAR     &kp AMPS     &kp COMMA    &kp DOT   &kp FSLH  &kp RET
&kp LCTRL  &kp LGUI  &kp LALT  &kp PIPE   &trans   &kp SPACE  &mo 2        &kp C_BRI_DN &kp C_BRI_UP &mo 2     &kp PG_DN &to 0
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            display-name = "SYM";
            bindings = <
&kp TILDE   &kp EXCL      &kp AT        &kp HASH      &kp DLLR      &kp PRCNT     &kp CARET    &kp AMPS    &kp STAR      &kp LPAR      &kp RPAR  &kp BSPC
&kp TAB     &kp F1        &kp F2        &kp F3        &kp F4        &kp F5        &kp F6       &kp F7      &kp F8        &kp F9        &kp F10   &kp PIPE
&kp LSHFT   &kp F11       &kp F12       &kp UNDER     &kp PLUS      &kp LBRC      &kp RBRC     &kp LT      &kp GT        &kp QMARK     &kp COLON &kp DQT
&kp LCTRL   &kp LGUI      &kp LALT      &trans        &mo 1         &kp SPACE     &trans       &kp HOME    &kp END       &trans        &kp PG_DN &to 0
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        control_layer {
            display-name = "MEDIA";
            bindings = <
&bootloader   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2       &bt BT_SEL 3  &bt BT_SEL 4  &out OUT_TOG &bt BT_CLR  &ext_power EP_TOG &sys_reset    &kp PSCRN &kp DEL
&kp TAB       &kp F1        &kp F2        &kp F3             &kp F4        &kp F5        &kp F6       &kp F7      &kp F8            &kp F9        &kp F10   &kp RET
&kp LSHFT     &kp C_PREV    &kp C_NEXT    &kp C_PP           &kp C_MUTE    &kp C_VOL_DN  &kp C_VOL_UP &kp M       &kp COMMA         &kp DOT       &kp FSLH  &trans
&out OUT_TOG  &kp LGUI      &kp LALT      &ext_power EP_TOG  &out OUT_BLE  &kp SPACE     &trans       &kp LEFT    &kp DOWN          &kp UP        &kp RIGHT &to 0
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
&kp ESC    &trans    &kp UP    &trans     &trans   &trans     &trans     &trans     &kp UP       &trans    &trans    &kp DEL
&trans     &kp LEFT  &kp DOWN  &kp RIGHT  &trans   &trans     &kp LEFT   &kp DOWN   &kp UP       &kp RIGHT &trans    &trans
&trans     &trans    &trans    &trans     &trans   &trans     &trans     &trans     &trans       &kp UP    &trans    &trans
&trans     &trans    &trans    &trans     &trans   &trans     &kp LEFT   &kp DOWN   &kp RIGHT    &trans    &kp UP    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};

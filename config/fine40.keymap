#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC    &kp Q     &kp W     &kp E      &kp R    &kp T      &kp Y        &kp U     &kp I      &kp O     &kp P     &kp BSPC
&lt 3 TAB  &kp A     &kp S     &kp D      &kp F    &kp G      &kp H        &kp J     &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z     &kp X     &kp C      &kp V    &kp B      &kp N        &kp M     &kp COMMA  &kp DOT   &kp FSLH  &kp RET
&kp LCTRL  &kp LGUI  &kp LALT  &kp BSLH   &mo 2    &kp SPACE  &lt 1 SPACE  &kp LEFT  &kp DOWN   &kp UP    &kp RIGHT &to 1
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            bindings = <
&kp GRAVE  &kp N1    &kp N2    &kp N3     &kp N4     &kp N5     &kp N6     &kp N7     &kp N8     &kp N9    &kp N0    &kp DEL
&kp TAB    &kp A     &kp S     &kp D      &kp F      &kp G      &kp H      &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH
&kp LSHFT  &kp Z     &kp X     &kp C      &kp V      &kp B      &kp N      &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp RET
&kp LCTRL  &kp LGUI  &kp LALT  &kp BSLH   &trans     &kp SPACE  &trans     &kp HOME   &kp PG_DN  &kp PG_UP &kp END   &to 2
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            bindings = <
&kp TILDE   &kp EXCL      &kp AT        &kp HASH      &kp DLLR      &kp PRCNT     &kp CARET    &kp AMPS    &kp STAR      &kp LPAR      &kp RPAR  &kp BSPC
&kp TAB     &kp A         &kp S         &kp D         &kp F         &kp G         &kp H        &kp UNDER   &kp PLUS      &kp LBRC      &kp RBRC  &kp PIPE
&kp LSHFT   &kp Z         &kp X         &kp C         &kp V         &kp B         &kp N        &kp M       &kp LT        &kp GT        &kp QMARK &kp RET
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &out OUT_TOG &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PP  &to 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        control_layer {
            bindings = <
&sys_reset      &bootloader  &bt BT_CLR  &bt BT_PRV         &bt BT_NXT   &kp F11    &kp F12    &kp PSCRN  &kp SLCK  &kp PAUSE_BREAK  &kp INS    &kp DEL
&kp TAB         &kp F1       &kp F2      &kp F3             &kp F4       &kp F5     &kp F6     &kp F7     &kp F8    &kp F9           &kp F10    &kp RET
&kp LSHFT       &kp Z        &kp X       &kp C              &kp V        &kp B      &kp N      &kp M      &kp COMMA &kp DOT          &kp FSLH   &kp RET
&studio_unlock  &kp LGUI     &kp LALT    &ext_power EP_TOG  &out OUT_BLE &kp SPACE  &trans     &kp LEFT   &kp DOWN  &kp UP           &kp RIGHT  &to 0
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};

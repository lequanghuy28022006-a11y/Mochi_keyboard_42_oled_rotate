#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC    &kp Q     &kp W     &kp E      &kp R    &kp T      &kp Y        &kp U     &kp I      &kp O     &kp P     &kp BSPC
&lt 3 TAB  &kp A     &kp S     &kp D      &kp F    &kp G      &kp H        &kp J     &kp K      &kp L     &kp SEMI  &kp RET
&kp LSHFT  &kp Z     &kp X     &kp C      &kp V    &kp B      &kp N        &kp M     &kp COMMA  &kp DOT   &kp FSLH  &kp SQT
&kp LCTRL  &kp LGUI  &kp LALT  &kp BSLH   &mo 2    &kp SPACE  &lt 1 SPACE  &kp LEFT  &kp UP     &kp DOWN  &kp RIGHT &to 1
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        right {
            bindings = <
&kp LS(GRAVE)  &kp LS(N1)    &kp LS(N2)    &kp LS(N3)    &kp LS(N4)    &kp LS(N5)    &kp LS(N6)  &kp LS(N7)  &kp LS(N8)     &kp LS(N9)    &kp LS(N0)  &kp DEL
&kp TAB        &kp A         &kp S         &kp D         &kp F         &kp G         &kp H       &kp MINUS   &kp EQUAL      &kp LBKT      &kp RBKT    &kp BSLH
&kp LSHFT      &kp Z         &kp X         &kp C         &kp V         &kp B         &kp N       &kp M       &kp LS(COMMA)  &kp LS(DOT)   &kp FSLH    &kp SQT
&bt BT_CLR     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp SPACE   &kp C_MUTE  &kp LEFT       &kp UP        &kp DOWN    &to 2
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        left {
            bindings = <
&kp GRAVE  &kp N1    &kp N2    &kp N3    &kp N4     &kp N5     &kp N6    &kp N7     &kp N8     &kp N9     &kp N0     &kp BSPC
&kp TAB    &kp A     &kp S     &kp D     &kp F      &kp G      &kp H     &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC   &kp RET
&kp LSHFT  &kp Z     &kp X     &kp C     &kp V      &kp B      &kp N     &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp SQT
&kp LCTRL  &kp LGUI  &kp LALT  &kp BSLH  &kp SPACE  &kp SPACE  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &kp RIGHT  &to 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        control {
            bindings = <
&sys_reset      &bootloader  &bt BT_CLR  &bt BT_PRV      &bt BT_NXT  &kp F11    &kp F12    &kp PSCRN  &kp SLCK  &kp PAUSE_BREAK  &kp INS    &kp DEL
&kp TAB         &kp F1       &kp F2      &kp F3          &kp F4      &kp F5     &kp F6     &kp F7     &kp F8    &kp F9           &kp F10    &kp RET
&kp LSHFT       &kp Z        &kp X       &kp C           &kp V       &kp B      &kp N      &kp M      &kp COMMA &kp DOT          &kp FSLH   &kp SQT
&studio_unlock  &kp LGUI     &kp LALT    &ext_power EP_ON &trans     &kp SPACE  &kp SPACE  &kp LEFT   &kp UP    &kp DOWN         &kp RIGHT  &to 0
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
